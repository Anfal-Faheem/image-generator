from flask import Flask, request, jsonify, send_from_directory
from flask_cors import CORS
import base64
import os
from dotenv import load_dotenv
from huggingface_hub import InferenceClient
from PIL import Image
import io

load_dotenv()

app = Flask(__name__)
CORS(app)

HF_TOKEN = os.getenv("HF_TOKEN", "")

# Initialize InferenceClient with fal-ai provider
client = InferenceClient(token=HF_TOKEN)

@app.route('/generate', methods=['POST'])
def generate_image():
    try:
        data = request.json or {}
        prompt = data.get('prompt', '')
        width = data.get('width', 1024)
        height = data.get('height', 1024)
        
        # FLUX-schnell works best between 4-8 steps. 
        # High steps (like 28) will fail or waste resources on this model.
        steps = data.get('steps', 4) 
        
        if not prompt:
            return jsonify({'error': 'Prompt is required'}), 400
        
        if not HF_TOKEN:
            return jsonify({'error': 'HuggingFace token not configured.'}), 401
        
        print(f"Generating: {prompt[:80]}...")

        # Calling the free serverless endpoint
        image = client.text_to_image(
            prompt=prompt,
            model="black-forest-labs/FLUX.1-schnell",
            width=width,
            height=height,
            num_inference_steps=steps
            # Note: guidance_scale is omitted here as FLUX.1-schnell 
            # ignores it or defaults internally.
        )
        
        # Convert PIL Image to bytes
        img_byte_arr = io.BytesIO()
        image.save(img_byte_arr, format='PNG')
        img_byte_arr = img_byte_arr.getvalue()
        
        # Convert to base64
        img_base64 = base64.b64encode(img_byte_arr).decode('utf-8')
        
        print("✅ Image generated successfully!")
        
        return jsonify({
            'success': True,
            'image': img_base64,
            'message': 'Image generated successfully'
        })
    
    except Exception as e:
        print(f"❌ Error: {str(e)}")
        return jsonify({'error': str(e)}), 500


@app.route('/health', methods=['GET'])
def health_check():
    return jsonify({
        'status': 'healthy',
        'model': 'FLUX.1-schnell',
        'provider': 'Hugging Face Serverless',
        'token_configured': bool(HF_TOKEN)
    })


@app.route('/')
def index():
    return send_from_directory('views', 'index.html')


@app.route('/<path:filename>')
def serve_static(filename):
    return send_from_directory('views', filename)


if __name__ == '__main__':
    print("\n" + "="*80)
    print(" 🎨 FLUX.1-DEV IMAGE GENERATOR")
    print("="*80)
    print(" Server: http://localhost:5000")
    print(" Using: huggingface_hub InferenceClient + fal-ai")
    print("="*80 + "\n")
    
    if not HF_TOKEN:
        print("⚠️  WARNING: No HF_TOKEN found in .env!")
    else:
        print("✅ Token loaded - Ready to generate!")
    
    app.run(host='0.0.0.0', port=5000, debug=True)
